\@writefile{loa}{\contentsline {algorithm}{\numberline {5.1}{\ignorespaces Example of an algorithm for bicubic interpolation in 2D \blx@tocontentsinit {0}\cite {BurgerBurge2022}, typeset with package \texttt  {algpseudocodex}. Function $\textcolor {AlgProcedureColor}{\textsf  {Cubic1D}}\hskip 0.75pt(x)$, used in lines \ref {alg:wcub1} and \ref {alg:wcub2}, calculates the weight given to the interpolation value at some one-dimensional position $x$.}}{44}{algorithm.5.1}\protected@file@percent }
\newlabel{alg:Example}{{5.1}{44}{Example of an algorithm for bicubic interpolation in 2D \cite {BurgerBurge2022}, typeset with package \texttt {algpseudocodex}. Function $\Call {Cubic1D}{x}$, used in lines \ref {alg:wcub1} and \ref {alg:wcub2}, calculates the weight given to the interpolation value at some one-dimensional position $x$}{algorithm.5.1}{}}
\newlabel{alg:wcub1}{{8}{44}{Example of an algorithm for bicubic interpolation in 2D \cite {BurgerBurge2022}, typeset with package \texttt {algpseudocodex}. Function $\Call {Cubic1D}{x}$, used in lines \ref {alg:wcub1} and \ref {alg:wcub2}, calculates the weight given to the interpolation value at some one-dimensional position $x$}{algorithm.5.1}{}}
\newlabel{alg:wcub2}{{9}{44}{Example of an algorithm for bicubic interpolation in 2D \cite {BurgerBurge2022}, typeset with package \texttt {algpseudocodex}. Function $\Call {Cubic1D}{x}$, used in lines \ref {alg:wcub1} and \ref {alg:wcub2}, calculates the weight given to the interpolation value at some one-dimensional position $x$}{algorithm.5.1}{}}
